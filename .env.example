# Copy to .env and fill in the key. `.env` is git-ignored; main.py loads it.
# The examples in the README were generated with Gemini through its
# OpenAI-compatible endpoint; any endpoint that speaks the OpenAI
# chat-completions format works (set LLM_BASE_URL and LLM_MODEL accordingly).

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash

# Optional. Reasoning models spend hidden thinking tokens from this budget.
# LLM_MAX_TOKENS=2048
