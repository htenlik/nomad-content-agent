# Copy to .env and fill in. `.env` is git-ignored; main.py loads it automatically.
# Any OpenAI-compatible chat-completions endpoint works. Examples:
#
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-4o-mini
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1                           LLM_MODEL=claude-sonnet-4-5
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-3.6-flash
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.3-70b-versatile
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1                              LLM_MODEL=llama3.1

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional (defaults shown). Keep values bare: the loader does not strip
# trailing comments.
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=2048
#   (reasoning models spend hidden thinking tokens from this budget)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3
#   (retries on HTTP 429 / 5xx with a growing delay)
